{
  "name": "selector-healer-vscode",
  "displayName": "Selector Healer",
  "description": "Detect broken test selectors, get confidence-scored healing suggestions, and apply AST-based quick fixes - local-first (no LLM, no telemetry). Supports Playwright, Cypress, WebdriverIO, and TestCafe.",
  "version": "0.1.0",
  "publisher": "YOUR_PUBLISHER_ID",
  "license": "MIT",
  "icon": "resources/icon.png",
  "galleryBanner": {
    "color": "#1e1e2e",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/YOUR_USERNAME/selector-healer"
  },
  "bugs": {
    "url": "https://github.com/YOUR_USERNAME/selector-healer/issues"
  },
  "homepage": "https://github.com/YOUR_USERNAME/selector-healer#readme",
  "engines": {
    "vscode": "^1.93.0",
    "node": ">=20.0.0"
  },
  "categories": ["Linters", "Testing", "Other"],
  "keywords": [
    "playwright",
    "cypress",
    "webdriverio",
    "testcafe",
    "selector",
    "testing",
    "e2e",
    "locator",
    "healer",
    "auto-fix",
    "self-healing"
  ],
  "activationEvents": [
    "onLanguage:typescript",
    "onLanguage:typescriptreact",
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "workspaceContains:selector-healer.config.ts"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "selector-healer",
          "title": "Selector Healer",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "selector-healer": [
        {
          "id": "selectorHealerDashboard",
          "name": "",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "selectorHealer.init",
        "title": "Selector Healer: Create Config",
        "icon": "$(new-file)"
      },
      {
        "command": "selectorHealer.verify",
        "title": "Selector Healer: Verify Now",
        "icon": "$(play)"
      },
      {
        "command": "selectorHealer.capture",
        "title": "Selector Healer: Capture Baseline",
        "icon": "$(database)"
      },
      {
        "command": "selectorHealer.applyAllFixes",
        "title": "Selector Healer: Apply All High-Confidence Fixes"
      },
      {
        "command": "selectorHealer.refresh",
        "title": "Selector Healer: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "selectorHealer.focusDashboard",
        "title": "Selector Healer: Open Dashboard",
        "icon": "$(dashboard)"
      },
      {
        "command": "selectorHealer.openDashboard",
        "title": "Selector Healer: Open Full Dashboard",
        "icon": "$(multiple-windows)"
      },
      {
        "command": "selectorHealer.undoLastHeal",
        "title": "Selector Healer: Undo Last Heal",
        "icon": "$(discard)"
      },
      {
        "command": "selectorHealer.showHealHistory",
        "title": "Selector Healer: Heal History",
        "icon": "$(history)"
      },
      {
        "command": "selectorHealer.toggleWatch",
        "title": "Selector Healer: Toggle Watch Mode",
        "icon": "$(eye)"
      },
      {
        "command": "selectorHealer.pruneStale",
        "title": "Selector Healer: Prune Stale Baseline",
        "icon": "$(trash)"
      },
      {
        "command": "selectorHealer.showMenu",
        "title": "Selector Healer: Menu"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "selectorHealer.verify",
          "when": "view == selectorHealerDashboard",
          "group": "navigation@1"
        },
        {
          "command": "selectorHealer.capture",
          "when": "view == selectorHealerDashboard",
          "group": "navigation@2"
        },
        {
          "command": "selectorHealer.toggleWatch",
          "when": "view == selectorHealerDashboard",
          "group": "navigation@3"
        },
        {
          "command": "selectorHealer.showHealHistory",
          "when": "view == selectorHealerDashboard",
          "group": "navigation@4"
        },
        {
          "command": "selectorHealer.openDashboard",
          "when": "view == selectorHealerDashboard",
          "group": "navigation@5"
        }
      ],
      "commandPalette": [
        {
          "command": "selectorHealer.showMenu",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Selector Healer",
      "properties": {
        "selectorHealer.lint.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show proactive fragility warnings for brittle locators (visible text, structural CSS, XPath) as you edit test files."
        },
        "selectorHealer.watch.debounceMs": {
          "type": "number",
          "default": 400,
          "minimum": 0,
          "markdownDescription": "Delay (in milliseconds) before Watch mode re-verifies a test file after you save it. Reload the window to apply a change."
        }
      }
    },
    "walkthroughs": [
      {
        "id": "selectorHealerGettingStarted",
        "title": "Get Started with Selector Healer",
        "description": "Catch broken test selectors before CI - capture a baseline, verify against the live DOM, and heal what broke. All local, no telemetry.",
        "steps": [
          {
            "id": "createConfig",
            "title": "Create a config",
            "description": "Point Selector Healer at your app - it auto-detects your framework, base URL, and test directory.\n[Create Config](command:selectorHealer.init)",
            "media": { "markdown": "media/walkthrough/create-config.md" },
            "completionEvents": ["onCommand:selectorHealer.init"]
          },
          {
            "id": "capture",
            "title": "Capture a baseline",
            "description": "Snapshot each selector against your live DOM, so the tool knows what a correct match looks like.\n[Capture Baseline](command:selectorHealer.capture)",
            "media": { "markdown": "media/walkthrough/capture.md" },
            "completionEvents": ["onCommand:selectorHealer.capture"]
          },
          {
            "id": "verify",
            "title": "Verify your selectors",
            "description": "Re-check every selector against the current DOM. Anything that no longer resolves is flagged as broken.\n[Verify Now](command:selectorHealer.verify)",
            "media": { "markdown": "media/walkthrough/verify.md" },
            "completionEvents": ["onCommand:selectorHealer.verify"]
          },
          {
            "id": "heal",
            "title": "Heal what broke",
            "description": "For each broken selector, apply a ranked, explainable fix - from the dashboard, a Quick Fix (Ctrl+.), or a CodeLens.\n[Open Dashboard](command:selectorHealer.focusDashboard)",
            "media": { "markdown": "media/walkthrough/heal.md" },
            "completionEvents": ["onCommand:selectorHealer.focusDashboard"]
          }
        ]
      }
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && node esbuild.mjs",
    "bundle": "node esbuild.mjs --production",
    "watch": "node esbuild.mjs",
    "test": "vitest run",
    "test:integration": "tsc -p test/integration/tsconfig.json && node test/integration/out/run-tests.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "package": "pnpm run bundle && vsce package --no-dependencies",
    "publish": "pnpm run bundle && vsce publish --no-dependencies",
    "vscode:prepublish": "node esbuild.mjs --production"
  },
  "dependencies": {
    "@selector-healer/core": "workspace:*",
    "cosmiconfig": "^9.0.1"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.17.0",
    "@types/vscode": "^1.93.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.28.0",
    "mocha": "^11.7.6",
    "playwright": "^1.52.0"
  }
}
