{
  "name": "selector-healer-vscode",
  "displayName": "Selector Healer",
  "description": "Detect broken Playwright selectors, get healing suggestions, and apply AST-based quick fixes — all inside VS Code.",
  "version": "0.0.1",
  "publisher": "selector-healer",
  "private": true,
  "type": "module",
  "license": "MIT",
  "icon": "resources/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/user/selector-healer"
  },
  "engines": {
    "vscode": "^1.93.0",
    "node": ">=20.0.0"
  },
  "categories": ["Linters", "Testing"],
  "keywords": ["playwright", "selector", "testing", "e2e", "locator", "healer", "auto-fix"],
  "activationEvents": [
    "onLanguage:typescript",
    "onLanguage:typescriptreact",
    "workspaceContains:selector-healer.config.ts"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "selector-healer",
          "title": "Selector Healer",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "selector-healer": [
        {
          "id": "selectorHealerExplorer",
          "name": "Selectors",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "selectorHealerExplorer",
        "contents": "No verification results yet.\n[Verify Now](command:selectorHealer.verify)\n[Capture Baseline](command:selectorHealer.capture)"
      }
    ],
    "commands": [
      {
        "command": "selectorHealer.verify",
        "title": "Selector Healer: Verify Now",
        "icon": "$(play)"
      },
      {
        "command": "selectorHealer.capture",
        "title": "Selector Healer: Capture Baseline",
        "icon": "$(database)"
      },
      {
        "command": "selectorHealer.applyAllFixes",
        "title": "Selector Healer: Apply All High-Confidence Fixes"
      },
      {
        "command": "selectorHealer.refresh",
        "title": "Refresh",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "selectorHealer.verify",
          "when": "view == selectorHealerExplorer",
          "group": "navigation@1"
        },
        {
          "command": "selectorHealer.capture",
          "when": "view == selectorHealerExplorer",
          "group": "navigation@2"
        },
        {
          "command": "selectorHealer.refresh",
          "when": "view == selectorHealerExplorer",
          "group": "navigation@3"
        }
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "package": "vsce package --no-dependencies",
    "vscode:prepublish": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@selector-healer/core": "workspace:*",
    "cosmiconfig": "^9.0.1"
  },
  "devDependencies": {
    "@types/vscode": "^1.93.0",
    "@vscode/vsce": "^3.2.0"
  }
}
